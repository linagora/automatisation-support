{
  "name": "automatisation-support",
  "version": "1.0.0",
  "description": "Backend service for automated customer support management: automated responses and AI-assisted ticket filling powered by SLM/LLM analysis.",
  "main": "dist/src/index.js",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:local:image": "tsx -r dotenv/config scripts/test-attachment-analysis/test-local-image.ts",
    "test:online:image": "tsx -r dotenv/config scripts/test-attachment-analysis/test-online-image.ts",
    "test:local:video": "tsx -r dotenv/config scripts/test-attachment-analysis/test-local-video.ts",
    "test:online:video": "tsx -r dotenv/config scripts/test-attachment-analysis/test-online-video.ts",
    "test:llm:guard": "tsx -r dotenv/config scripts/test-attachment-analysis/test-token-budget-guard.ts",
    "test:fullweight": "tsx scripts/test-attachment-analysis/test-full-weight-analysis.ts",
    "test:message-analysis": "tsx scripts/test-attachment-analysis/test-message-analysis.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georgesabolin1/automatisation-support.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/georgesabolin1/automatisation-support/issues"
  },
  "homepage": "https://github.com/georgesabolin1/automatisation-support#readme",
  "private": true,
  "dependencies": {
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
