# OpenRAG
OPENRAG_BASE_URL=https://demo.open-rag.ai
OPENRAG_TOKEN=
# If your API expects "Authorization: Bearer <token>", keep Bearer.
# If it expects the raw token only, set OPENRAG_AUTH_SCHEME=
OPENRAG_AUTH_SCHEME=Bearer
OPENRAG_PARTITION=automatisation_support
# Optional: add indexed files to one workspace. Leave empty if unused.
OPENRAG_WORKSPACE_ID=
# true = try to create the partition before indexing
OPENRAG_CREATE_PARTITION=true
# auto = check if file exists, then POST or PUT. post = always POST. put = always replace.
OPENRAG_UPLOAD_MODE=auto

# GitHub repository to index
GITHUB_OWNER=
GITHUB_REPO=
# Optional for public repos, required for private repos and recommended for rate limits.
GITHUB_TOKEN=
GITHUB_API_VERSION=2022-11-28

# Issue selection
GITHUB_ISSUE_LIMIT=100
GITHUB_ISSUE_STATE=closed
GITHUB_ISSUE_SORT=comments
GITHUB_ISSUE_DIRECTION=desc
# Optional comma-separated labels, e.g. bug,support,android
GITHUB_LABELS=
# Optional ISO date, e.g. 2026-01-01T00:00:00Z
GITHUB_SINCE=
GITHUB_INCLUDE_COMMENTS=true

# Local output/debug
RUN_MODE=extract
OUTPUT_DIR=generated/issues
MANIFEST_FILE=generated/issues-manifest.json
SELECTION_FILE=generated/selected-issues.json
DRY_RUN=false
REQUEST_DELAY_MS=150
