# LLM API Configuration for Multi-Model Support
# Copy this file to .env and fill in your credentials
#
# This configuration supports multiple LLM models for different use cases.
# Each preset (default, vision, fast, premium) can use different providers.
#
# Naming convention: {PRESET}_API_HOST, {PRESET}_API_KEY, {PRESET}_MODEL
# If preset-specific variables are not set, it falls back to generic LLM_* or OPENAI_* variables.

# =============================================================================
# DEFAULT PRESET - Used for general text processing
# =============================================================================
LLM_API_HOST=https://your-api-host.com/api
LLM_API_KEY=your-api-key-here
LLM_MODEL=mistralai/mistral-small-3.2-24b-instruct
# Optional: LLM_PROVIDER=mistral

# =============================================================================
# VISION PRESET - Used for image/video analysis
# Can be the same as default or a different model with vision capabilities
# =============================================================================
# LLM_VISION_API_HOST=https://your-api-host.com/api
# LLM_VISION_API_KEY=your-vision-api-key-here
# LLM_VISION_MODEL=gpt-4-vision-preview
# LLM_VISION_PROVIDER=openai

# =============================================================================
# FAST PRESET - Used for quick, simple tasks (optional)
# =============================================================================
# LLM_FAST_API_HOST=https://your-api-host.com/api
# LLM_FAST_API_KEY=your-fast-api-key-here
# LLM_FAST_MODEL=mistralai/mistral-small-3.2-24b-instruct
# LLM_FAST_PROVIDER=mistral

# =============================================================================
# PREMIUM PRESET - Used for complex reasoning (optional)
# =============================================================================
# LLM_PREMIUM_API_HOST=https://your-api-host.com/api
# LLM_PREMIUM_API_KEY=your-premium-api-key-here
# LLM_PREMIUM_MODEL=gpt-4
# LLM_PREMIUM_PROVIDER=openai

# =============================================================================
# LEGACY FALLBACK (optional - used if preset-specific vars are not set)
# These provide backward compatibility and fallback values
# =============================================================================
# OPENAI_API_HOST=https://your-api-host.com/api
# OPENAI_API_KEY=your-api-key-here