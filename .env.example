# =============================================================================
# IMAGE ANALYSIS - Analyse d'images (+ texte optionnel)
# =============================================================================
LLM_IMAGE_API_HOST=https://your-api-host.com/api
LLM_IMAGE_API_KEY=your-api-key-here
LLM_IMAGE_MODEL=mistralai/mistral-small-3.2-24b-instruct

# =============================================================================
# VIDEO ANALYSIS - Analyse de vidéos (+ texte optionnel)
# =============================================================================
LLM_VIDEO_API_HOST=https://your-api-host.com/api
LLM_VIDEO_API_KEY=your-api-key-here
LLM_VIDEO_MODEL=mistralai/mistral-small-3.2-24b-instruct

# =============================================================================
# QUICK DECISION - Décision rapide : réponse simple ou analyse complète ?
# =============================================================================
LLM_QUICK_API_HOST=https://your-api-host.com/api
LLM_QUICK_API_KEY=your-api-key-here
LLM_QUICK_MODEL=mistralai/mistral-small-3.2-24b-instruct

# =============================================================================
# FULL ANALYSIS - Analyse complète (message + état ticket + logs)
# =============================================================================
LLM_FULL_API_HOST=https://your-api-host.com/api
LLM_FULL_API_KEY=your-api-key-here
LLM_FULL_MODEL=mistralai/mistral-small-3.2-24b-instruct

# =============================================================================
# RAG SEARCH - Recherche sur l'Open RAG Linagora
# =============================================================================
LLM_RAG_API_HOST=https://your-rag-host.com/api
LLM_RAG_API_KEY=your-rag-api-key-here
LLM_RAG_MODEL=mistralai/mistral-small-3.2-24b-instruct

# =============================================================================
# MATRIX - Envoi manuel vers une room Matrix
# =============================================================================
MATRIX_HOMESERVER_URL=
MATRIX_ACCESS_TOKEN=
MATRIX_ROOM_ID=

# =============================================================================
# FALLBACK GÉNÉRIQUE (si aucune variable preset n'est définie)
# =============================================================================
LLM_API_HOST=https://your-api-host.com/api
LLM_API_KEY=your-api-key-here
LLM_MODEL=mistralai/mistral-small-3.2-24b-instruct
